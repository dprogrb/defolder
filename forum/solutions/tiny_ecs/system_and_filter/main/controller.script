local tiny = require("tinyecs.tiny")
local MovementSystem = require("systems.movement_system")

local Position = require("components.position")
local Velocity = require("components.velocity")
local GoID = require("components.go_id")

local function spawn_entity(self, x, y)
	self.entity_id = self.entity_id + 1

	local id = factory.create("#factory", vmath.vector3(x, y, 0))

	local entity = {
		id = "entity_" .. self.entity_id,
		[Position] = { x = x, y = y, z = 0 },
		[Velocity] = { x = math.random(-100, 100), y = 0 },
		[GoID] = id
	}
	
	self.world:addEntity(entity)
	
	print("Создана сущность: " .. entity.id .. " в (" .. x .. ", " .. y .. ")")	
end

function init(self)
	self.world = tiny.world()
	self.world:addSystem(MovementSystem)
	self.entity_id = 0
	
	msg.post(".", "acquire_input_focus")
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	self.world:update(dt)
end

