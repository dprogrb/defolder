end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_state_menu") then
		GSFSM.machine:menu()
		print("Current STATE: " ..GSFSM.machine.current)
		monarch.show(hash("menu"))
	elseif message_id == hash("set_state_game") then
		GSFSM.machine:game()
		print("Current STATE: " ..GSFSM.machine.current)
		monarch.show(hash("game"))
	elseif message_id == hash("set_state_game_over") then
		GSFSM.machine:game_over()
		print("Current STATE: " ..GSFSM.machine.current)
		monarch.show(hash("game"))
	elseif message_id == hash("set_state_settings") then
		GSFSM.machine:settings()
		print("Current STATE: " ..GSFSM.machine.current)
		monarch.show(hash("game"))
	elseif message_id == hash("set_state_pause") then
		GSFSM.machine:pause()
		print("Current STATE: " ..GSFSM.machine.current)
		monarch.show(hash("pause")) 
	end
end